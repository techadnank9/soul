SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgres://user:password@host:5432/postgres
APPLE_BUNDLE_ID=space.soul.soul

# The roster identifier is accepted as a bearer token only when this is exactly
# the word allow. It is how the app is driven from a laptop without signing in.
# Never set it in production: a rostering identifier is shared with a district's
# own systems and is not a secret.
SOUL_ROSTER_TOKENS=allow
